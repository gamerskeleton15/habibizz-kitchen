# Habibizz Kitchens - Environment Configuration (Vercel)
#
# On Vercel, set these in Project Settings -> Environment Variables.
# Locally, copy this file to .env for the dev server.
#
# DO NOT commit your .env file to git (it's already in .gitignore).

# ===== Upstash Redis (REQUIRED for Vercel) =====
# Get a free DB at https://console.upstash.com/ (no credit/debit card).
# After creating a Global DB, click "Connect" -> "REST" and copy the
# URL and TOKEN here. Free tier: 10,000 commands/day, 256 MB.
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ===== Admin password (REQUIRED in production) =====
# Used by POST /api/admin/login. Locally this also falls back to
# backend/data/config.json if the env var is missing.
ADMIN_PASSWORD=change-me-to-a-strong-password

# ===== Google OAuth (Optional) =====
# Get these from https://console.cloud.google.com/
# Authorized redirect URIs to register:
#   - http://localhost:4000/auth/google/callback   (local dev)
#   - https://YOUR-VERCEL-DOMAIN.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ===== GitHub OAuth (Optional) =====
# Get these from https://github.com/settings/developers
# Authorization callback URL to register:
#   - http://localhost:4000/auth/github/callback  (local dev)
#   - https://YOUR-VERCEL-DOMAIN.vercel.app/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# ===== OAuth callback host (REQUIRED in production) =====
# Your backend's public URL on Vercel (NO trailing slash). The OAuth
# redirect_uri is built from this. Update this after the first deploy
# if Vercel gives you a different domain than you expected.
PUBLIC_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# ===== Frontend origin (REQUIRED in production) =====
# Where the SPA lives. Used for CORS and for the post-OAuth redirect.
# Should match your Vercel frontend project URL (NO trailing slash).
FRONTEND_URL=https://YOUR-FRONTEND-VERCEL-DOMAIN.vercel.app
FRONTEND_ORIGIN=https://YOUR-FRONTEND-VERCEL-DOMAIN.vercel.app

# ===== Session Secret (REQUIRED in production) =====
# Used to sign session cookies. Generate a random string.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-string-at-least-32-characters-long

# ===== Gemini AI (Optional) =====
# Get a free key at https://aistudio.google.com/app/apikey
# Enables the AI auto-responder in the support chat.
GEMINI_API_KEY=your-gemini-api-key-here
