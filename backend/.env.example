# Habibizz Kitchens - Environment Configuration
# Copy this file to .env and fill in the values below.
# DO NOT commit your .env file to git (it's already in .gitignore).

# ===== Google OAuth =====
# Get these from https://console.cloud.google.com/
# 1. Create a new project (or select an existing one)
# 2. Enable the "Google+ API" or "People API"
# 3. Go to "Credentials" → "Create Credentials" → "OAuth client ID"
# 4. Choose "Web application"
# 5. Add these Authorized redirect URIs:
#    - http://localhost:4000/auth/google/callback (for development)
#    - https://yourdomain.com/auth/google/callback (for production)
# 6. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ===== GitHub OAuth =====
# Get these from https://github.com/settings/developers
# 1. Click "New OAuth App"
# 2. Application name: Habibizz Kitchens (or anything you like)
# 3. Homepage URL: http://localhost:5173 (for development)
# 4. Authorization callback URL: http://localhost:4000/auth/github/callback
# 5. Click "Register application"
# 6. Copy the Client ID and generate a Client Secret
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# ===== Session Secret =====
# Used to sign session cookies. Generate a random string for production.
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-string-at-least-32-characters-long

# ===== Gemini AI (Optional) =====
# Get a free API key from https://aistudio.google.com/app/apikey
# This enables the AI auto-responder in the support chat.
# Without it, customer messages still work but the AI falls back to a generic reply.
GEMINI_API_KEY=your-gemini-api-key-here
